# ============================================
# 光语助手后端 - 环境变量模板
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，禁止提交）
# ============================================

# 阿里云百炼 API Key（必填）
# 获取方式：登录 https://bailian.console.aliyun.com/ → API-KEY 管理 → 创建我的 API-KEY
ALIYUN_API_KEY=your_aliyun_key_here

# 阿里云百炼 OpenAI 兼容模式接入地址（一般无需修改）
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 视觉识别模型（默认 qwen-vl-max，也可换 qwen-vl-plus）
ALIYUN_VISION_MODEL=qwen-vl-max

# 文本对话模型（默认 qwen-plus，也可换 qwen-max / qwen-turbo）
ALIYUN_TEXT_MODEL=qwen-plus

# ============================================
# 本地 Qwen2-VL 视觉服务（vlm_server.py，可选，推荐）
# 部署：backend 目录下 python vlm_server.py（需 GPU + transformers）
# 模型：backend/models/qwen2-vl-2b-instruct/（约 4.5GB，离线部署）
# ============================================
# 视觉识别是否优先走本地服务（失败自动降级阿里云）
LOCAL_VLM_ENABLED=1
# 本地 VLM 服务地址（vlm_server.py 监听地址）
LOCAL_VLM_BASE_URL=http://127.0.0.1:8100/v1
# 本地 VLM 模型名（请求体中的 model 字段，本地服务不校验具体值）
LOCAL_VLM_MODEL=qwen2-vl-2b-instruct
